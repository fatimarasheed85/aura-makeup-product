<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code | default: 'en' }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#FBF9F5">
    <link rel="canonical" href="{{ canonical_url }}">
    
    <title>
      {{ page_title | default: 'Aura Beauty' }}
      {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
      {%- unless page_title contains 'Aura Beauty' %} &ndash; Aura Beauty Luxury{% endunless -%}
    </title>

    <meta name="description" content="{{ page_description | default: 'Aura Beauty Luxury E-Commerce - Bio-compatible, clean botanical skincare for effortless dewy glass skin.' }}">

    <!-- Design System Typography & Icons -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet">

    <!-- Theme Stylesheet -->
    {{ 'aura-luxury.css' | asset_url | stylesheet_tag }}

    <!-- Asset URL Mapper for Client Engine -->
    <script>
      window.AURA_ASSETS = {
        serum: "{{ 'serum.png' | asset_url }}",
        lipOil: "{{ 'lip-oil.png' | asset_url }}",
        barrierCream: "{{ 'barrier-cream.png' | asset_url }}",
        portrait: "{{ 'portrait.png' | asset_url }}",
        brandLogo: "{{ 'brand-logo.png' | asset_url }}",
        homePreview: "{{ 'home-preview.png' | asset_url }}"
      };
    </script>
    
    {{ content_for_header }}
  </head>

  <body>
    <!-- Interactive Demo Navigation Showcase -->
    <nav class="demo-top-bar" aria-label="Demo Page Switcher">
      <div style="display: flex; align-items: center; gap: 0.5rem;">
        <span style="font-weight: 700; color: #dfb7a7; letter-spacing: 0.05em;">✦ AURA SHOPIFY DEMO:</span>
        <span style="color: #a89f9b;">Quick Page Switcher:</span>
      </div>
      <div style="display: flex; align-items: center; gap: 0.35rem; flex-wrap: wrap;">
        <a href="#home" data-view="home">1. Home</a>
        <a href="#collection" data-view="collection">2. Collection</a>
        <a href="#product" data-view="product">3. Product Detail</a>
        <a href="#cart" data-view="cart">4. Bag / Cart</a>
        <a href="#checkout" data-view="checkout">5. Checkout</a>
        <a href="#faq" data-view="faq">6. FAQ</a>
        <a href="#blog" data-view="blog">7. Blog</a>
        <a href="#about" data-view="about">8. About Us</a>
        <a href="#contact" data-view="contact">9. Contact</a>
        <a href="#tracking" data-view="tracking">10. Order Tracking</a>
      </div>
    </nav>

    <!-- Announcement Bar -->
    {% section 'announcement-bar' %}

    <!-- Site Header -->
    {% section 'header' %}

    <!-- Cart Drawer -->
    {% render 'cart-drawer' %}

    <!-- Main Dynamic Content -->
    <main id="MainContent" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    <!-- Site Footer -->
    {% section 'footer' %}

    <!-- Theme Client Engine -->
    <script src="{{ 'aura-theme.js' | asset_url }}" defer="defer"></script>
  </body>
</html>
