<header class="site-header">
  <div class="container">
    <div class="header-inner">
      <div class="header-left">
        <button class="nav-toggle-btn" aria-label="Navigation Menu">
          <span class="material-symbols-outlined" style="font-size: 22px;">menu</span>
        </button>
        <button class="header-icon-btn" aria-label="Search Catalog">
          <span class="material-symbols-outlined" style="font-size: 20px;">search</span>
        </button>
      </div>

      <nav class="main-nav" aria-label="Primary Navigation">
        <a href="#home" class="nav-link" data-view="home">Home</a>
        <a href="#collection" class="nav-link" data-view="collection">Collections</a>
        <a href="#product" class="nav-link" data-view="product">Rituals</a>
        <a href="#about" class="nav-link" data-view="about">Philosophy</a>
        <a href="#blog" class="nav-link" data-view="blog">Journal</a>
      </nav>

      <a href="#home" class="site-logo" data-view="home">
        <img src="{{ 'brand-logo.png' | asset_url }}" alt="Aura Beauty Logo" width="36" height="36">
        <span>AURA</span>
      </a>

      <div class="header-right">
        <a href="#tracking" class="header-icon-btn" data-view="tracking" aria-label="Order Tracking" title="Track Order">
          <span class="material-symbols-outlined" style="font-size: 20px;">local_shipping</span>
        </a>
        <a href="#cart" class="header-icon-btn cart-icon-btn" data-action="open-cart" data-view="cart" aria-label="Shopping Bag">
          <span class="material-symbols-outlined" style="font-size: 22px;">shopping_bag</span>
          <span class="cart-count-badge">2</span>
        </a>
        <div style="width: 32px; height: 32px; border-radius: var(--radius-full); overflow: hidden; background: var(--color-surface-container); border: 1px solid var(--color-border); display: flex; align-items: center; justify-content: center;">
          <img src="{{ 'portrait.png' | asset_url }}" alt="Account Profile" width="32" height="32" style="width: 100%; height: 100%; object-fit: cover;">
        </div>
      </div>
    </div>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo Image"
    }
  ]
}
{% endschema %}
