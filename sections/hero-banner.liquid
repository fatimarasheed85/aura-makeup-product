<section class="hero-section" data-view-section="home" style="padding: 2rem 0 3rem; background: var(--color-canvas);">
  <div class="container">
    <div style="display: grid; grid-template-columns: 1fr; gap: 2.5rem; align-items: center;" class="hero-grid">
      
      <!-- Text & Value Props -->
      <div style="display: flex; flex-direction: column; gap: 1.25rem;">
        <div style="display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.3rem 0.85rem; border-radius: var(--radius-full); background: var(--color-blush-soft); align-self: flex-start;">
          <span style="width: 6px; height: 6px; border-radius: 50%; background: var(--color-secondary);"></span>
          <span class="label-sm" style="color: var(--color-secondary);">New Botanical Harvest</span>
        </div>

        <h1 class="display-hero" style="color: var(--color-text-primary);">
          Skin-First Radiance,<br>
          <span style="font-style: italic; font-weight: 300;">Bottled.</span>
        </h1>

        <p class="body-lg" style="color: var(--color-text-secondary); max-width: 480px;">
          Clinical purity meets sensory indulgence. Cultivate your natural, dew-lit glow with cold-pressed bioactive formulations engineered for barrier resilience.
        </p>

        <div style="display: flex; gap: 1rem; align-items: center; flex-wrap: wrap; padding-top: 0.5rem;">
          <a href="#collection" data-view="collection" class="btn-primary" style="padding: 0.9rem 2rem; border-radius: var(--radius-md);">
            <span>Discover the Collection</span>
            <span class="material-symbols-outlined" style="font-size: 18px;">arrow_forward</span>
          </a>
          <a href="#product" data-view="product" class="btn-secondary" style="padding: 0.9rem 1.75rem; border-radius: var(--radius-md);">
            The Dewy Routine
          </a>
        </div>
      </div>

      <!-- Hero Visual Card with Spotlight -->
      <div style="position: relative; border-radius: var(--radius-xl); overflow: hidden; background: var(--color-surface-card); border: 1px solid var(--color-border); box-shadow: var(--shadow-card-hover);">
        <div style="aspect-ratio: 4/5; width: 100%; position: relative; overflow: hidden;">
          <img src="{{ 'serum.png' | asset_url }}" alt="Luminous Dew Elixir" width="600" height="750" style="width: 100%; height: 100%; object-fit: cover;">
          <div style="position: absolute; inset: 0; background: linear-gradient(to top, rgba(43,36,33,0.35) 0%, transparent 60%);"></div>
          
          <!-- Floating Spotlight Badge -->
          <div style="position: absolute; bottom: 1.25rem; left: 1.25rem; right: 1.25rem; background: rgba(251, 249, 245, 0.92); backdrop-filter: blur(12px); border-radius: var(--radius-lg); padding: 1rem 1.25rem; display: flex; align-items: center; justify-content: space-between; border: 1px solid rgba(234, 227, 220, 0.8);">
            <div>
              <span class="label-sm" style="color: var(--color-secondary);">Spotlight Routine</span>
              <h3 style="font-family: var(--font-serif); font-size: 1.15rem; color: var(--color-text-primary); margin-top: 2px;">Luminous Dew Elixir</h3>
            </div>
            <div style="display: flex; align-items: center; gap: 1rem;">
              <span style="font-family: var(--font-serif); font-size: 1.2rem; font-weight: 600; color: var(--color-text-primary);">$68</span>
              <button onclick="window.quickAddProduct('elixir-01')" class="btn-primary btn-pill" style="padding: 0.4rem 1rem; font-size: 0.75rem;">Add</button>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<!-- Trust Bar -->
<section style="background: var(--color-surface-low); border-top: 1px solid var(--color-border); border-bottom: 1px solid var(--color-border); padding: 1.5rem 0;">
  <div class="container">
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 1.5rem; text-align: center;">
      <div style="display: flex; flex-direction: column; align-items: center; gap: 0.5rem;">
        <div style="width: 36px; height: 36px; border-radius: 50%; background: var(--color-surface-container); display: flex; align-items: center; justify-content: center; color: var(--color-secondary);">
          <span class="material-symbols-outlined" style="font-size: 20px;">eco</span>
        </div>
        <div>
          <h4 style="font-size: 0.875rem; font-weight: 600; color: var(--color-text-primary);">100% Clean Actives</h4>
          <p style="font-size: 0.75rem; color: var(--color-text-secondary); margin-top: 2px;">Cold-pressed unbleached botanicals</p>
        </div>
      </div>

      <div style="display: flex; flex-direction: column; align-items: center; gap: 0.5rem;">
        <div style="width: 36px; height: 36px; border-radius: 50%; background: var(--color-surface-container); display: flex; align-items: center; justify-content: center; color: var(--color-secondary);">
          <span class="material-symbols-outlined" style="font-size: 20px;">pets</span>
        </div>
        <div>
          <h4 style="font-size: 0.875rem; font-weight: 600; color: var(--color-text-primary);">Cruelty-Free Certified</h4>
          <p style="font-size: 0.75rem; color: var(--color-text-secondary); margin-top: 2px;">Ethically formulated in Paris &amp; Kyoto</p>
        </div>
      </div>

      <div style="display: flex; flex-direction: column; align-items: center; gap: 0.5rem;">
        <div style="width: 36px; height: 36px; border-radius: 50%; background: var(--color-surface-container); display: flex; align-items: center; justify-content: center; color: var(--color-secondary);">
          <span class="material-symbols-outlined" style="font-size: 20px;">forest</span>
        </div>
        <div>
          <h4 style="font-size: 0.875rem; font-weight: 600; color: var(--color-text-primary);">Carbon-Neutral Shipping</h4>
          <p style="font-size: 0.75rem; color: var(--color-text-secondary); margin-top: 2px;">Biodegradable seed-paper packaging</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  @media (min-width: 900px) {
    .hero-grid {
      grid-template-columns: 1fr 1fr !important;
    }
  }
</style>

{% schema %}
{
  "name": "Hero Banner",
  "settings": []
}
{% endschema %}
