<div data-view-section="blog" style="background: var(--color-canvas); padding: 3rem 0 5rem;">
  <div class="container">
    
    <header style="text-align: center; margin-bottom: 3.5rem;">
      <span class="label-sm" style="color: var(--color-secondary); letter-spacing: 0.1em;">Editorial Spread</span>
      <h1 class="display-hero" style="color: var(--color-text-primary); margin-top: 0.5rem;">The Radiance Journal</h1>
      <p class="body-lg" style="color: var(--color-text-secondary); max-width: 550px; margin: 0.75rem auto 0;">
        Ritual essays, botanical harvest dispatches, and mindful practices for timeless glass-skin health.
      </p>
    </header>

    <!-- Featured Magazine Spread -->
    <div style="background: var(--color-surface-card); border: 1px solid var(--color-border); border-radius: var(--radius-xl); overflow: hidden; margin-bottom: 3.5rem; display: grid; grid-template-columns: 1fr; gap: 2rem; align-items: center;" class="featured-article-grid">
      <div style="aspect-ratio: 16/10; overflow: hidden; position: relative;">
        <img src="{{ 'portrait.png' | asset_url }}" alt="Dewy Glass Skin Editorial" width="600" height="375" style="width: 100%; height: 100%; object-fit: cover;">
      </div>
      <div style="padding: 1.5rem 2rem 2rem;">
        <span class="badge-award">Cover Story • 6 min read</span>
        <h2 class="headline-md" style="color: var(--color-text-primary); margin: 0.75rem 0 0.5rem;">
          Cultivating Glass Skin: The Architecture of Pure Lipid Layering
        </h2>
        <p class="body-md" style="margin-bottom: 1.25rem;">
          Why synthetic occlusives fail, and how biocompatible botanical squalane, camellia seed oil, and micro-fermented ceramides create lasting luminosity from within.
        </p>
        <div style="display: flex; align-items: center; justify-content: space-between;">
          <span style="font-size: 0.75rem; color: var(--color-text-muted);">By Dr. Elena Vance • Chief Botanical Biochemist</span>
          <a href="/product" class="btn-primary btn-pill" style="font-size: 0.8rem; padding: 0.5rem 1.25rem;">Read Essay</a>
        </div>
      </div>
    </div>

    <!-- Article Matrix -->
    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 2rem;">
      
      <!-- Article 1 -->
      <article style="background: var(--color-surface-card); border: 1px solid var(--color-border); border-radius: var(--radius-lg); overflow: hidden; display: flex; flex-direction: column;">
        <div style="aspect-ratio: 16/10; overflow: hidden;">
          <img src="{{ 'serum.png' | asset_url }}" alt="Travertine Bottle" width="400" height="250" loading="lazy" style="width: 100%; height: 100%; object-fit: cover;">
        </div>
        <div style="padding: 1.5rem; display: flex; flex-direction: column; flex: 1;">
          <span class="label-sm" style="color: var(--color-secondary);">Botanical Science</span>
          <h3 style="font-family: var(--font-serif); font-size: 1.2rem; color: var(--color-text-primary); margin: 0.5rem 0;">
            The Autumn Camellia Harvest in Kyoto
          </h3>
          <p class="body-md" style="margin-bottom: 1rem; flex: 1;">
            A behind-the-scenes look at our sustainable zero-heat press extraction in the mist-veiled mountains of Uji.
          </p>
          <a href="/collection" style="font-size: 0.8125rem; font-weight: 600; text-decoration: underline; color: var(--color-text-primary);">Discover Harvest &rarr;</a>
        </div>
      </article>

      <!-- Article 2 -->
      <article style="background: var(--color-surface-card); border: 1px solid var(--color-border); border-radius: var(--radius-lg); overflow: hidden; display: flex; flex-direction: column;">
        <div style="aspect-ratio: 16/10; overflow: hidden;">
          <img src="{{ 'barrier-cream.png' | asset_url }}" alt="Whipped Barrier Cream" width="400" height="250" loading="lazy" style="width: 100%; height: 100%; object-fit: cover;">
        </div>
        <div style="padding: 1.5rem; display: flex; flex-direction: column; flex: 1;">
          <span class="label-sm" style="color: var(--color-secondary);">Morning Ritual</span>
          <h3 style="font-family: var(--font-serif); font-size: 1.2rem; color: var(--color-text-primary); margin: 0.5rem 0;">
            The 3-Step Dew Awakening: Lymphatic Drainage
          </h3>
          <p class="body-md" style="margin-bottom: 1rem; flex: 1;">
            Awaken facial vitality with temperature stimulation and cold-pressed whipping techniques.
          </p>
          <a href="/product" style="font-size: 0.8125rem; font-weight: 600; text-decoration: underline; color: var(--color-text-primary);">Explore Ritual &rarr;</a>
        </div>
      </article>

      <!-- Article 3 -->
      <article style="background: var(--color-surface-card); border: 1px solid var(--color-border); border-radius: var(--radius-lg); overflow: hidden; display: flex; flex-direction: column;">
        <div style="aspect-ratio: 16/10; overflow: hidden;">
          <img src="{{ 'lip-oil.png' | asset_url }}" alt="Petal Rose Lip Oil" width="400" height="250" loading="lazy" style="width: 100%; height: 100%; object-fit: cover;">
        </div>
        <div style="padding: 1.5rem; display: flex; flex-direction: column; flex: 1;">
          <span class="label-sm" style="color: var(--color-secondary);">Sensory Beauty</span>
          <h3 style="font-family: var(--font-serif); font-size: 1.2rem; color: var(--color-text-primary); margin: 0.5rem 0;">
            Damask Rose: The Alchemy of Petal Peptides
          </h3>
          <p class="body-md" style="margin-bottom: 1rem; flex: 1;">
            How natural anthocyanins provide sheer, effortless blushing tints without synthetic microplastics.
          </p>
          <a href="/collection" style="font-size: 0.8125rem; font-weight: 600; text-decoration: underline; color: var(--color-text-primary);">View Lip Oil &rarr;</a>
        </div>
      </article>

    </div>
  </div>
</div>

<style>
  @media (min-width: 900px) {
    .featured-article-grid {
      grid-template-columns: 1.2fr 1fr !important;
    }
  }
</style>

{% schema %}
{
  "name": "Main Blog",
  "settings": []
}
{% endschema %}
